%% Example project driving aihtml through its rebar3 plugin end to end.
%%
%% `rebar3 compile' here runs the mustache provider first, which turns
%% *.mustache into modules under _gen/ and then lets the normal Erlang
%% compiler pick them up via src_dirs.
%%
%% aihtml and rebar3_aihtml are wired in through _checkouts/, which symlinks
%% the sibling directories in this repository. rebar3 has no `path' resource
%% -- a {path, Dir} dep or plugin fails with fetch_fail -- so _checkouts is
%% the mechanism rebar3 offers for building against a local tree. A real
%% project would use the git form shown in the top-level README instead.

{plugins, [rebar3_aihtml]}.

{deps, [aihtml]}.

{provider_hooks, [{pre, [{compile, mustache}, {compile, jinja}]}]}.

{mustache_opts, [{views,    "views"},
                 {suffix,   ".mustache"},
                 {out_dir,  "_gen"},
                 {prefix,   "view_"},
                 {line_map, true}]}.

{erl_opts, [debug_info, {src_dirs, ["src", "_gen"]}]}.

%% The two engines share one out_dir. Each generated file names its engine in
%% its banner, and each provider only collects its own orphans -- without that,
%% whichever ran last would delete the other's output.
{jinja_opts, [{views,   "views/jinja"},
              {suffix,  ".j2"},
              {out_dir, "_gen"},
              {prefix,  "j2_"},
              {escape,  true},
              {trim_blocks, true},
              {lstrip_blocks, true},
              {line_map, true}]}.

%% Umbrella fixture: two apps, a shared project level mustache_opts and one
%% app that overrides it. Both apps ship views/index.mustache, so with the
%% shared prefix they collide across apps and the plugin has to say so.
{plugins, [rebar3_aihtml]}.
{deps, [aihtml]}.
{mustache_opts, [{views, "views"}, {out_dir, "_gen"}, {prefix, "view_"}]}.
{erl_opts, [debug_info, {src_dirs, ["src", "_gen"]}]}.

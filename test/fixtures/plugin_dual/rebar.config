%% Fixture project: both engines, one out_dir.
%%
%% This is the arrangement that used to break: each provider's orphan
%% collector would see the other's output as an orphan and delete it, so the
%% build result depended on which ran last.
{plugins, [rebar3_aihtml]}.

{deps, [aihtml]}.

{provider_hooks, [{pre, [{compile, mustache}, {compile, jinja}]}]}.

{mustache_opts, [{views, "views"}, {suffix, ".mustache"}, {prefix, "view_"}]}.
{jinja_opts,    [{views, "views"}, {suffix, ".j2"},       {prefix, "j2_"}]}.

{erl_opts, [debug_info, {src_dirs, ["src", "_gen"]}]}.

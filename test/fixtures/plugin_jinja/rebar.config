%% Fixture project for the jinja half of rebar3_aihtml_SUITE.
%%
%% aihtml and rebar3_aihtml are wired in through _checkouts/, which the suite
%% populates when it copies this tree into priv_dir. rebar3 has no `path'
%% resource, so a {path, ...} dep or plugin cannot be used here; _checkouts is
%% the mechanism rebar3 does offer for building against a local tree.
{plugins, [rebar3_aihtml]}.

{deps, [aihtml]}.

{provider_hooks, [{pre, [{compile, jinja}]}]}.

{jinja_opts, [{views,   "views"},
              {suffix,  ".j2"},
              {out_dir, "_gen"},
              {prefix,  "j2_"},
              {escape,  true},
              {trim_blocks, true},
              {lstrip_blocks, true},
              {line_map, true}]}.

{erl_opts, [debug_info, {src_dirs, ["src", "_gen"]}]}.

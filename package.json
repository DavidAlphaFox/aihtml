{
  "name": "aihtml-assets",
  "private": true,
  "description": "Asset build for aihtml: Tailwind CSS v4 and vendored jQuery",
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm run vendor && npm run js && npm run css",
    "js": "node scripts/build-js.mjs",
    "test": "node scripts/test-js.mjs",
    "vendor": "node scripts/vendor.mjs",
    "css": "npm run css:index && npm run css:lib && npm run css:example",
    "css:index": "node scripts/gen-css-index.mjs",
    "css:lib": "tailwindcss -i apps/aihtml/assets/aihtml.build.css -o apps/aihtml/priv/static/aihtml.css --minify",
    "css:example": "tailwindcss -i apps/aihtml_example/assets/example.css -o apps/aihtml_example/priv/static/example.css --minify",
    "watch:example": "tailwindcss -i apps/aihtml_example/assets/example.css -o apps/aihtml_example/priv/static/example.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "jquery": "^4.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "markdown-it": "^14.3.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5"
  }
}

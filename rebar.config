%% aihtml umbrella.
%%
%%   apps/aihtml          the library: Erlang prefabs -> HTML (jQuery + Tailwind)
%%   apps/aihtml_example  cowboy demo, never a dependency of the library
%%
%% Consumers depend on the library alone through git_subdir, see README.md.
{erl_opts, [debug_info,
            warnings_as_errors,
            warn_export_vars,
            warn_shadow_vars,
            warn_obsolete_guard,
            warn_missing_spec]}.

{deps, []}.

{project_app_dirs, ["apps/*"]}.

{shell, [{apps, [aihtml_example]},
         %% rebar3 shell cannot read the release's sys.config.src (${VAR}
         %% placeholders), so it gets its own plain config.
         {config, "config/shell.config"}]}.

{dialyzer, [{warnings, [unmatched_returns, error_handling, unknown]},
            {plt_extra_apps, [beamai_render, ranch, cowlib, mnesia]}]}.

{xref_checks, [undefined_function_calls, undefined_functions,
               locals_not_used, deprecated_function_calls,
               deprecated_functions]}.

%% The example application as a release.
{relx, [{release, {aihtml_example, "0.1.0"},
         [aihtml_example,
          %% Loaded, not started: aihtml_example_store creates the disc
          %% schema first and starts mnesia itself (a disc schema cannot be
          %% created while mnesia runs).
          {mnesia, load},
          sasl]},
        {sys_config_src, "config/sys.config.src"},
        {vm_args_src, "config/vm.args.src"},
        {dev_mode, true},
        {include_erts, false},
        {extended_start_script, true}]}.

{profiles, [{test, [{erl_opts, [nowarn_missing_spec]}]},
            %% rebar3 as prod tar: a self-contained tarball with ERTS
            {prod, [{relx, [{dev_mode, false},
                            {include_erts, true},
                            {include_src, false}]}]}]}.

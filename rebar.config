%% aihtml -- Mustache template engine that compiles templates to Erlang modules.
%%
%% Zero dependencies by design (decision D5, see designs/02-architecture.md).
%% Runtime code depends only on OTP; the test suites use OTP's built-in `json`
%% module to read the vendored mustache spec, so the test profile is dep-free too.

{erl_opts, [debug_info,
            warn_export_vars,
            warn_shadow_vars,
            warn_obsolete_guard,
            warn_missing_spec,
            warnings_as_errors]}.

{deps, []}.

{profiles,
 [{test,
   [{deps, []},
    {erl_opts, [nowarn_export_all, nowarn_missing_spec]},
    %% Non-recursive on purpose. test/fixtures holds whole rebar3 projects for
    %% rebar3_aihtml_SUITE, and their .erl files are sources of those projects,
    %% not of this one: compiled here they would be reported as test modules
    %% that cannot be found. Every real test module sits directly in test/.
    %% The directory itself is still copied into the build tree, which is what
    %% ai_mustache_test_lib:spec_dir/0 and the fixtures both rely on.
    {extra_src_dirs, [{"test", [{recursive, false}]}]}]}]}.

{dialyzer,
 [{warnings, [unknown, no_improper_lists]},
  {plt_extra_apps, [compiler, syntax_tools]}]}.

{xref_checks,
 [undefined_function_calls,
  undefined_functions,
  locals_not_used,
  deprecated_function_calls]}.

{ct_opts, [{keep_logs, 10}]}.

%% aihtml umbrella.
%%
%%   apps/aihtml          the library: Erlang prefabs -> HTML (jQuery + Tailwind)
%%   apps/aihtml_example  cowboy demo, never a dependency of the library
%%
%% Consumers depend on the library alone through git_subdir, see README.md.
{erl_opts, [debug_info,
            warnings_as_errors,
            warn_export_vars,
            warn_shadow_vars,
            warn_obsolete_guard,
            warn_missing_spec]}.

{deps, []}.

{project_app_dirs, ["apps/*"]}.

{shell, [{apps, [aihtml_example]}]}.

{dialyzer, [{warnings, [unmatched_returns, error_handling, unknown]},
            {plt_extra_apps, [beamai_render, ranch, cowlib]}]}.

{xref_checks, [undefined_function_calls, undefined_functions,
               locals_not_used, deprecated_function_calls,
               deprecated_functions]}.

{profiles, [{test, [{erl_opts, [nowarn_missing_spec]}]}]}.

%% rebar3_aihtml -- the rebar3 plugin that compiles .mustache into .erl.
%%
%% Zero third-party dependencies (decision D5): {deps, []} is empty and the
%% plugin only calls rebar3's own exported API (rebar_state, rebar_app_info,
%% rebar_api, rebar_dir, rebar_file_utils, providers) plus OTP.
%%
%% The compile core (ai_mustache_scanner/parser/ast/compiler) lives in the
%% parent app. A rebar3 plugin and a project dependency are loaded into two
%% different code domains -- the plugin at build time, the dep at target time
%% -- so the plugin cannot rely on the aihtml dep being on the code path when
%% `rebar3 mustache' runs bare, and it must not need a dependency of its own
%% (D5). It therefore compiles the parent's src/ alongside its own.
%%
%% "../src" is the right path when the plugin is used the way it ships, that
%% is fetched from git with {subdir, "rebar3_aihtml"}, or built standalone from
%% this repository: the plugin directory sits directly under the aihtml
%% checkout either way.
%%
%% It is NOT right under rebar3's _checkouts mechanism, which symlinks only
%% src/include/priv into the build tree, so the sibling directory is simply not
%% there. That is what the fallback in rebar3_aihtml_prv:require_core/1 is for:
%% it borrows the aihtml the project already depends on. (rebar3 has no `path'
%% resource -- {path, Dir} deps and plugins fail with fetch_fail -- so
%% _checkouts is the only way to build against a local tree, which is what the
%% test suite does.)
%%
%% extra_src_dirs rather than src_dirs, because src_dirs would also make
%% rebar3 discover ../src/aihtml.app.src and refuse to build ("multiple app
%% files in one app dir"). The price is that these beams land beside the
%% plugin's ebin rather than inside it; rebar3_aihtml:init/1 puts that
%% directory on the code path.
{erl_opts, [debug_info,
            warn_export_vars,
            warn_shadow_vars,
            warn_obsolete_guard,
            {i, "../include"}]}.

%% Deliberately NOT warn_missing_spec + warnings_as_errors like the parent
%% app: rebar3's own API types (rebar_state:t(), rebar_app_info:t(),
%% providers:t()) are opaque and cannot be spelled precisely from outside, so
%% the parent's strictness is relaxed here and only here.

{extra_src_dirs, ["../src"]}.

{deps, []}.

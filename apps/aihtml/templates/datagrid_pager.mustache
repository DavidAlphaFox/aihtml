<div class="ah-dg-pager" role="navigation" aria-label="{{label}}"><div class="ah-dg-pager-info" aria-live="polite">{{info}}</div><div class="ah-dg-pager-controls"><button type="button" class="ah-dg-pager-button" data-page="1" aria-label="{{first_label}}"{{#at_start}} disabled{{/at_start}}>|&lt;</button><button type="button" class="ah-dg-pager-button" data-page="{{prev}}" aria-label="{{prev_label}}"{{#at_start}} disabled{{/at_start}}>&lt;</button>{{#pages}}<button type="button" class="ah-dg-pager-button{{#active}} ah-dg-pager-button-active{{/active}}" data-page="{{page}}"{{#active}} aria-current="page"{{/active}}>{{page}}</button>{{/pages}}<button type="button" class="ah-dg-pager-button" data-page="{{next}}" aria-label="{{next_label}}"{{#at_end}} disabled{{/at_end}}>&gt;</button><button type="button" class="ah-dg-pager-button" data-page="{{last}}" aria-label="{{last_label}}"{{#at_end}} disabled{{/at_end}}>&gt;|</button></div><div class="ah-dg-pager-size"><select class="ah-dg-pager-size-select" aria-label="{{size_label}}">{{#sizes}}<option value="{{size}}"{{#selected}} selected{{/selected}}>{{text}}</option>{{/sizes}}</select></div></div>

<div class="ah-dti-cal-nav"><div class="ah-dti-cal-prev" data-action="prev-month" role="button" aria-label="{{prev_month}}">◀</div><div class="ah-dti-cal-title" aria-live="polite">{{title}}</div><div class="ah-dti-cal-next" data-action="next-month" role="button" aria-label="{{next_month}}">▶</div></div>
<div class="ah-dti-cal-header" aria-hidden="true">{{#weekdays}}<span>{{label}}</span>{{/weekdays}}</div>
<div class="ah-dti-cal-grid">{{#days}}<div class="{{cls}}" data-date="{{date}}" role="button" aria-label="{{date}}"{{#disabled}} aria-disabled="true"{{/disabled}}{{#selected}} aria-pressed="true"{{/selected}}>{{day}}</div>{{/days}}</div>
{{#show_time}}<div class="ah-dti-time-row"><span class="ah-dti-time-label">{{time_label}}</span><input class="ah-dti-time-input" data-field="hours" type="text" inputmode="numeric" maxlength="2" value="{{hours}}" aria-label="Hours"><span class="ah-dti-time-sep">:</span><input class="ah-dti-time-input" data-field="minutes" type="text" inputmode="numeric" maxlength="2" value="{{minutes}}" aria-label="Minutes"></div>{{/show_time}}

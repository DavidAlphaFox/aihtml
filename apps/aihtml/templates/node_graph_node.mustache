{{! A node card (sigil data/node-graph). View: id, title, has_type, type, style (transform, width, height, accent), collapsed, sized, expanded ("true"/"false"), toggle_label, stub_in / stub_out ([] or [{color}]), inputs / outputs (slot views: kind, key, index, connected, optional, tip, shape, multi, color, slices [{d, fill}], has_label, label), has_widgets, widgets [{html}] (trusted HTML), has_body, body (trusted HTML), resizable. }}<div class="ah-node-graph-node" data-node-id="{{id}}" role="group" aria-label="{{title}}"{{#collapsed}} data-collapsed="true"{{/collapsed}}{{#sized}} data-sized="true"{{/sized}} style="{{style}}"><div class="ah-node-graph-node-header"><button class="ah-node-graph-collapse" type="button" aria-label="{{toggle_label}}" aria-expanded="{{expanded}}"></button><span class="ah-node-graph-node-title">{{title}}</span>{{#has_type}}<span class="ah-node-graph-node-type">{{type}}</span>{{/has_type}}</div>{{#stub_in}}<span class="ah-node-graph-stub" data-side="in" style="--ah-ng-dot-color:{{color}}"></span>{{/stub_in}}{{#stub_out}}<span class="ah-node-graph-stub" data-side="out" style="--ah-ng-dot-color:{{color}}"></span>{{/stub_out}}<div class="ah-node-graph-node-body"><div class="ah-node-graph-slots"><div class="ah-node-graph-slot-col" data-side="in">{{#inputs}}<div class="ah-node-graph-slot" data-kind="{{kind}}"{{#connected}} data-connected="true"{{/connected}}{{#optional}} data-optional="true"{{/optional}} data-slot-key="{{key}}" data-slot-index="{{index}}"><span class="ah-node-graph-slot-hit" title="{{tip}}">{{#multi}}<svg class="ah-node-graph-dot" data-shape="{{shape}}" data-multi="true" viewBox="0 0 100 100">{{#slices}}<path d="{{d}}" style="fill:{{fill}}"></path>{{/slices}}</svg>{{/multi}}{{^multi}}<span class="ah-node-graph-dot" data-shape="{{shape}}" style="--ah-ng-dot-color:{{color}}"></span>{{/multi}}</span>{{#has_label}}<span class="ah-node-graph-slot-label">{{label}}</span>{{/has_label}}</div>{{/inputs}}</div><div class="ah-node-graph-slot-col" data-side="out">{{#outputs}}<div class="ah-node-graph-slot" data-kind="{{kind}}"{{#connected}} data-connected="true"{{/connected}}{{#optional}} data-optional="true"{{/optional}} data-slot-key="{{key}}" data-slot-index="{{index}}"><span class="ah-node-graph-slot-hit" title="{{tip}}">{{#multi}}<svg class="ah-node-graph-dot" data-shape="{{shape}}" data-multi="true" viewBox="0 0 100 100">{{#slices}}<path d="{{d}}" style="fill:{{fill}}"></path>{{/slices}}</svg>{{/multi}}{{^multi}}<span class="ah-node-graph-dot" data-shape="{{shape}}" style="--ah-ng-dot-color:{{color}}"></span>{{/multi}}</span>{{#has_label}}<span class="ah-node-graph-slot-label">{{label}}</span>{{/has_label}}</div>{{/outputs}}</div></div>{{#has_widgets}}<div class="ah-node-graph-widgets">{{#widgets}}<div class="ah-node-graph-widget">{{{html}}}</div>{{/widgets}}</div>{{/has_widgets}}{{#has_body}}<div class="ah-node-graph-custom">{{{body}}}</div>{{/has_body}}</div>{{#resizable}}<span class="ah-node-graph-node-resize"></span>{{/resizable}}</div>

<div class="{{cls}}" data-file-id="{{id}}"><div class="ah-upload-item-icon ah-upload-item-icon-{{icon}}" aria-hidden="true"></div><div class="ah-upload-item-info"><div class="ah-upload-item-name-row"><span class="ah-upload-item-name" title="{{name}}">{{name}}</span><span class="ah-upload-item-size">{{size}}</span></div>{{#uploading}}<div class="ah-upload-item-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{percent}}" aria-label="{{name}}"><div class="ah-upload-item-progress-bar" style="width:{{percent}}%"></div></div>{{/uploading}}{{#has_error}}<div class="ah-upload-item-error" role="alert">{{error}}</div>{{/has_error}}</div><div class="ah-upload-item-actions"><button type="button" class="ah-upload-item-remove" title="{{remove}}" aria-label="{{remove}} {{name}}"{{#disabled}} disabled{{/disabled}}>&times;</button></div></div>

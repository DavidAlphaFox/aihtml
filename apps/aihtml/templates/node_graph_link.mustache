{{! A link of a node graph: SVG, inserted into <svg class="ah-node-graph-links">. View: id, selected, d (path data), color (CSS colour), points [{index, x, y, color}] (reroute points). }}<g class="ah-node-graph-link" data-link-id="{{id}}"{{#selected}} data-selected="true"{{/selected}}><path class="ah-node-graph-link-hit" d="{{d}}"></path><path class="ah-node-graph-link-line" d="{{d}}" style="stroke:{{color}}"></path>{{#points}}<circle class="ah-node-graph-waypoint" data-index="{{index}}" cx="{{x}}" cy="{{y}}" r="5" style="fill:{{color}}"></circle>{{/points}}</g>

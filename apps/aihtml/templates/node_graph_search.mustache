{{! The result list of the node graph's search menu. View: list_id, empty, empty_text, items [{index, label, active, has_category, category}]. }}{{#empty}}<div class="ah-node-graph-search-empty">{{empty_text}}</div>{{/empty}}{{^empty}}<ul class="ah-node-graph-search-list" role="listbox" id="{{list_id}}">{{#items}}<li class="ah-node-graph-search-item" role="option" id="{{list_id}}-{{index}}" data-index="{{index}}"{{#active}} data-active="true" aria-selected="true"{{/active}}><span class="ah-node-graph-search-label">{{label}}</span>{{#has_category}}<span class="ah-node-graph-search-cat">{{category}}</span>{{/has_category}}</li>{{/items}}</ul>{{/empty}}

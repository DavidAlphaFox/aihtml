<div class="ah-dg-group-row" role="row" data-group-id="{{id}}" data-level="{{level}}" aria-level="{{aria_level}}" aria-expanded="{{expanded}}"><span class="ah-dg-group-indent" style="width:{{indent}}px"></span><span class="ah-dg-group-toggle{{#open}} ah-dg-group-toggle-open{{/open}}" aria-hidden="true">▶</span><span class="ah-dg-group-title" role="gridcell" aria-colspan="{{colspan}}">{{title}} ({{count}})</span>{{#has_aggs}}<span class="ah-dg-group-aggregates">{{#aggs}}<span class="ah-dg-group-agg-item">{{label}}: {{text}}</span>{{/aggs}}</span>{{/has_aggs}}</div>

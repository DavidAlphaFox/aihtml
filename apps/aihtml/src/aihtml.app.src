{application, aihtml,
 [{description, "Erlang prefabs that render HTML for TailwindCSS and a Stimulus runtime"},
  {vsn, "0.1.0"},
  {registered, [aihtml_sup, aihtml_push]},
  {mod, {aihtml_app, []}},
  {applications, [kernel, stdlib, crypto, beamai_render]},
  {env, []},
  {modules, []},
  {licenses, ["Apache-2.0"]},
  {links, [{"GitHub", "https://github.com/DavidAlphaFox/aihtml"}]}]}.

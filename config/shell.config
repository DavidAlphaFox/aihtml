%% Configuration for `rebar3 shell` (development). The release uses
%% config/sys.config.src instead, whose ${VAR} placeholders only the
%% release start script substitutes -- rebar3 shell cannot read it.
[{aihtml_example, [{port, 8080},
                   {db_storage, disc_copies}]},
 %% No aihtml secret here: a random one is generated per start, which is
 %% fine for development (pages from a previous run get 403 on actions).
 {kernel, [{logger_level, notice}]}].
